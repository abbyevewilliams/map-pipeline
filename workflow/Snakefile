# Point to config file
configfile: "config/config.yaml"

# Shared metadata, settings and helper functions
include: "common.smk"

# ==============================================================================
#     Default "All" Target Rule
# ==============================================================================

# This rule requests that other rules be run.

rule all:
    input:
        FASTQC_TARGETS["pre_trim"],
        FASTQC_TARGETS["post_trim"] if TRIM_READS else [],
        "results/mapping_summary.txt",                        # summary of stats
        "results/avg_depth.txt",                              # average depth

localrules:
    all

# ==============================================================================
#     Rule Modules
# ==============================================================================

include: "rules/01_fastqc.smk"
if TRIM_READS:
    include: "rules/02_trim.smk"
include: "rules/03_map.smk"
include: "rules/04_dedup.smk"
include: "rules/05_stats.smk"
if MAPDAMAGE_RESCALE:
    include: "rules/06_damage.smk"